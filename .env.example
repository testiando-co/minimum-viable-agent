OPENAI_API_KEY=...
ANTHROPIC_API_KEY=...
GOOGLE_API_KEY=...

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=my-agent

# Modelo LangChain en formato proveedor:modelo (ej. google_genai:gemini-3.5-flash-lite)
MVA_MODEL=anthropic:claude-opus-5-5

# Embeddings locales (FastEmbed) para el RAG
MVA_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM local con Ollama (1 = usar Ollama para el LLM y los embeddings del RAG)
LOCAL_LLM=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma
