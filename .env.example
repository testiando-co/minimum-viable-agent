OPENAI_API_KEY=...
ANTHROPIC_API_KEY=...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=...

# Trazas en LangSmith (una traza por ejecución del agente).
# Define LANGSMITH_PROJECT o LANGSMITH_AGENT_ID/LANGSMITH_AGENT_ENVIRONMENT, no ambos.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=my-agent

# Modelo LangChain en formato proveedor:modelo. Por defecto openrouter:openrouter/auto
# (OpenRouter elige el modelo de cada llamada; requiere OPENROUTER_API_KEY). Otras opciones:
# google_genai:gemini-3.6-flash (gratis con GOOGLE_API_KEY; resuelve bien las 3 trampas del
# WI-4052) o anthropic:claude-opus-5-5.
# Ojo: los modelos gratuitos tienen límites de solicitudes por minuto/día (429/503); el bucle
# del agente hace al menos 3 llamadas por vuelta.
MVA_MODEL=openrouter:openrouter/auto

# Embeddings locales (FastEmbed) para el RAG
MVA_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM local con Ollama (1 = usar Ollama para el LLM y los embeddings del RAG)
LOCAL_LLM=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma

# Carpeta del vector store persistente (RAG y memoria de largo plazo)
MVA_CHROMA_DIR=chroma.db

# Vueltas máximas del bucle del agente (sense → reason → plan → act ↺) antes de escalar
MVA_MAX_ITERATIONS=3

# Segundos de espera antes de retomar desde el paso pendiente si el LLM falla (429/503)
MVA_PLAN_RETRY_DELAY=10
